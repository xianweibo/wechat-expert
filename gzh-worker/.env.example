# ============================================
# gzh-worker - 环境变量模板 (NAS 上跑)
# ============================================
# 用法：  cp .env.example .env   然后填入真实值
# ⚠️ .env 已在 .gitignore，绝不提交到 Git
# 🗺️ 变量来源：gzh-worker/src/config.ts、minimax.ts、poster.ts
# ============================================

# --- B站登录态 (从浏览器 Cookie 复制) ---
BILIBILI_SESSDATA=__FILL_FROM_BROWSER_COOKIE__
BILIBILI_BILI_JCT=__FILL_FROM_BROWSER_COOKIE__
BILIBILI_UID=144796213

# --- 目标 UP 主（有何高见9527） ---
TARGET_UP_UID=290663424

# --- MiniMax AI ---
MINIMAX_API_KEY=__FILL_FROM_SERVER__
# 默认值已写在 config.ts：
#   endpoint = https://api.minimaxi.com/anthropic/v1/messages
#   model    = MiniMax-M2.7
# 一般无需修改；如需覆盖可加：
# MINIMAX_ENDPOINT=
# MINIMAX_MODEL=

# --- Worker → 阿里云 推送鉴权（必须和阿里云 .env 一致） ---
BILIBILI_WORKER_SECRET=__FILL_FROM_SERVER__

# --- 阿里云 API 地址 ---
ALIYUN_API_URL=http://8.134.248.11:3000/api/bilibili/summary

# --- 已处理视频记录（容器内 /app/data/last_bvid.txt） ---
LAST_BVID_FILE=/app/data/last_bvid.txt