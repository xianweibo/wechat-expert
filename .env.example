# ============================================
# 公众号专家 - 环境变量完整参考
# ============================================
# 用法：  cp .env.example .env   然后填入真实值
# ⚠️ .env 已在 .gitignore，绝不提交到 Git
# 📖 完整恢复流程见 RESTORE.md
# 🗺️ 变量来源扫描自 src/index.ts、src/mp_proxy.ts、src/cover_gen.ts、gzh-worker/src/*.ts
# 🔄 最后同步: 2026-09-05（与代码实际读取的变量名对齐）
# ============================================

# ============================================
# 一、运行环境
# ============================================
NODE_ENV=production
PORT=3000

# ============================================
# 二、微信公众号（src/mp_proxy.ts 用）
# ============================================
WECHAT_APP_ID=wx567a639466e247cd
WECHAT_APP_SECRET=__FILL_FROM_SERVER__

# ============================================
# 三、Worker 鉴权（⚠️ 两个名字必须填同一个值）
# ============================================
# BILIBILI_WORKER_SECRET: mp_proxy /api/admin/* 端点鉴权
# GZH_WORKER_SECRET:      /api/bilibili/summary 鉴权 + 服务内部自调用
BILIBILI_WORKER_SECRET=__FILL_FROM_SERVER__
GZH_WORKER_SECRET=__FILL_FROM_SERVER__

# ============================================
# 四、B 站登录态（SESSDATA 90 天过期，过期前 1 周主动更新）
# ============================================
# 可通过 /api/admin/bilibili-qrcode-headless-start 扫码自动更新写入
BILIBILI_SESSDATA=
BILIBILI_BILI_JCT=
BILIBILI_BILITICKET=

# ============================================
# 五、MiniMax（总结 / 标题改写 / 封面 prompt / 兜底出图）
# ============================================
MINIMAX_API_KEY=__FILL_FROM_SERVER__
MINIMAX_HOST=api.minimaxi.com
MINIMAX_LLM_MODEL=MiniMax-M3
MINIMAX_IMAGE_MODEL=image-01-live

# ============================================
# 六、魔搭 ModelScope（封面主通道，FLUX 异步出图）
# ============================================
MoTa_API_KEY=
MOTASCOPE_MODEL=Tongyi-MAI/Z-Image-Turbo
MOTASCOPE_HOST=api-inference.modelscope.cn

# ============================================
# 七、内容生成
# ============================================
# 草稿 author 字段（2026-06-15 与用户敲定固定值）
DEFAULT_AUTHOR=小喇叭大只讲
# 语言风格档案路径（refresh_style.sh 产出 style_summary.txt 后填入）
# 为空则降级到内置 prompt
STYLE_PATH=

# ============================================
# 八、告警推送（B 站 SESSDATA 保鲜任务检测到失效时）
# ============================================
# Server酱 sendkey（推荐，国内个人）：https://sct.ftqq.com/
SERVERCHAN_SENDKEY=
# 飞书机器人 webhook URL（备选）
FEISHU_WEBHOOK_URL=

# ============================================
# 九、旧版封面模块 cover_gen.ts（可选，当前主流程未启用）
# ============================================
# 仅当部署 origin/main 的 cover_gen 独立封面管线时才需要：
COVER_STYLE=
COVER_ASPECT_RATIO=
COVER_TEXT_OVERLAY=true
COVER_RETRY_MAX=
COVER_RETRY_BASE_MS=
COVERS_DIR=
# MiniMax 出图 key，未填则回退 MINIMAX_API_KEY
MINIMAX_IMAGE_API_KEY=
# 固定封面图 URL（cover_gen 关闭时的兜底）
COVER_IMAGE_URL=

# ============================================
# 十、gzh-worker（NAS 端，已因 B 站风控停摆，备查）
# ============================================
# NAS 侧 .env 单独维护，见 gzh-worker/.env.example
TARGET_UP_UID=290663424
BILIBILI_UID=144796213
ALIYUN_API_URL=http://127.0.0.1:39800/api/bilibili/summary
LAST_BVID_FILE=/app/data/last_bvid.txt

# ============================================
# 十一、数据库（docker-compose 起 PostgreSQL，当前代码未使用）
# ============================================
POSTGRES_USER=gzh_expert
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=gzh_expert
DATABASE_URL=postgresql://gzh_expert:CHANGE_ME_STRONG_PASSWORD@postgres:5432/gzh_expert

# ============================================
# 十二、域名 / FRP（部署文档用）
# ============================================
SERVER_HOST=8.134.248.11
DOMAIN=gzh.relexplace.com
FRP_AUTH_TOKEN=__FILL_FROM_SERVER__
FRP_WEB_PASSWORD=__FILL_FROM_SERVER__

# ============================================
# 十三、GitHub（CI/部署时使用）
# ============================================
GITHUB_TOKEN=

# ============================================
# 十四、沙箱/NAS 风格档案 RAG 流水线（refresh_style.sh 用，NAS 侧）
# ============================================
# MiniMax 用于"分析我自己的语言风格"（注意：NAS 脚本读的是 MINIMAX_KEY 这个名字）
MINIMAX_KEY=
MINIMAX_MODEL=MiniMax-M3
# 公众号 AppSecret 文件路径（与阿里云 test-mp.sh 一致）
MP_APP_SECRET_FILE=/tmp/.mp_app_secret
# Chroma 写入地址（NAS 容器内）
CHROMA_BASE=http://127.0.0.1:8100
CHROMA_COLLECTION=gzh_articles
